# ── Banco de dados (PostgreSQL 14+ com extensões unaccent e pg_trgm disponíveis) ──
DATABASE_URL="postgresql://usuario:senha@localhost:5432/eba?schema=public"

# ── Aplicação ──
APP_URL="http://localhost:3000"
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres)
SESSION_SECRET="troque-por-um-valor-aleatorio-de-32+-caracteres"

# ── E-mail: log (não envia; grava na caixa de saída) | resend | smtp ──
EMAIL_PROVIDER="log"
EMAIL_FROM="Escola Bíblica Atitude <nao-responda@seudominio.com.br>"
# RESEND_API_KEY=""
# SMTP_URL="smtps://usuario:senha@smtp.seudominio.com.br:465"

# ── Armazenamento de arquivos ──
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
UPLOAD_MAX_MB="200"

# ── Somente desenvolvimento/demonstração (NUNCA em produção) ──
# Mostra as contas demo na tela de login.
DEMO_MODE="false"
# Afrouxa rate limits para QA automatizado local (ignorado em produção).
# RATE_LIMIT_RELAXED="true"

# ── Primeiro administrador (usado por `npm run db:bootstrap`; remova a senha depois) ──
# ADMIN_EMAIL="voce@seudominio.com.br"
# ADMIN_PASSWORD=""
# ADMIN_NAME="Administrador"
